#!/usr/bin/python3
import datetime as dt
import os
import sys

sys.path.insert(0, os.environ.get("MANIFESTOS_LIB_DIR", "/usr/lib/manifestos"))

import manifestos_common as mc

REMINDER_DAYS = (7, 1, 0)


def main():
    now = dt.datetime.now()
    today = now.date()
    state_path = mc.STATE_DIR / "daily.json"
    state = mc.load_json(state_path, {})
    sent = set(state.get("sent", {}).get(today.isoformat(), []))
    settings = mc.load_settings()

    def send(key, title, body, icon="manifestos"):
        if key not in sent and mc.notify(title, body, icon):
            sent.add(key)

    celebrating = mc.birthdays_on(today)
    for m in celebrating:
        age = mc.age_on(mc.parse_date(m["birthday"]), today)
        send(
            f"birthday:{m['id']}",
            mc.tr("Happy birthday, {name}! 🎂").format(name=m["short"]),
            mc.tr("{name} turns {age} today. Send her some love!").format(name=m["short"], age=age),
        )

    if settings.get("birthday_wallpaper", True):
        current = state.get("birthday_wallpaper")
        if celebrating:
            wanted = celebrating[0]["id"]
            if current != wanted and mc.set_wallpaper(mc.birthday_image(wanted), attempts=10):
                state["birthday_wallpaper"] = wanted
        elif current and mc.set_wallpaper(mc.wallpaper_image(settings.get("bias", mc.GROUP_ID)), attempts=10):
            state["birthday_wallpaper"] = None

    for item in mc.upcoming(now):
        days = (item["when"].date() - today).days
        if days not in REMINDER_DAYS or (item["kind"] == "birthday" and days == 0):
            continue
        key = f"{item['kind']}:{item['title']}:{item['when']:%Y-%m-%dT%H:%M}:{days}"
        if days == 0:
            body = mc.tr("It's today!") if item["all_day"] else mc.tr("Starts at {time}.").format(time=f"{item['when']:%H:%M}")
        elif days == 1:
            body = mc.tr("Tomorrow")
        else:
            body = mc.tr("in {days} days").format(days=days)
        send(key, item["title"], body)

    state["sent"] = {today.isoformat(): sorted(sent)}
    mc.save_json(state_path, state)
    return 0


if __name__ == "__main__":
    sys.exit(main())
